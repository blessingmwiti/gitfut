# ── Deployment identity ────────────────────────────────────────────────────
# Canonical origin for every share link, sitemap entry and OG caption. Next
# inlines NEXT_PUBLIC_* at build time, so rebuild the image when this changes.
NEXT_PUBLIC_SITE_URL=https://gitfut.blessingmwiti.com

# ── GitHub ─────────────────────────────────────────────────────────────────
# Required for live scouting. Fine-grained, READ-ONLY token with public-repo
# access — no write scopes are ever needed. Without it the app serves the baked
# sample cards only.
GITHUB_TOKEN=

# Optional: comma-separated tokens from distinct accounts. Multiplies the
# GraphQL hourly ceiling (~5k points/hr per account). GITHUB_TOKEN alone is fine.
# GITHUB_TOKENS=

# ── Redis (optional) ───────────────────────────────────────────────────────
# Card cache + scout counter + token health. The app is fully functional
# without it and simply won't touch a Redis it can't reach.
# REDIS_URL=redis://127.0.0.1:6379/1

# ── Sentry (optional) ──────────────────────────────────────────────────────
# Leave the DSN unset to build without Sentry. Supplying it opts the build into
# the Sentry webpack plugin.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_URL=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── Umami analytics (optional) ─────────────────────────────────────────────
# The upstream instance (umami.gitfut.com) is not reachable from this
# deployment. Set both to use your own Umami instance; leave unset for none.
# NEXT_PUBLIC_UMAMI_SRC=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
